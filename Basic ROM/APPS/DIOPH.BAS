10 PRINT "DIOPHANTINE SOLVER"
20 N=0
30 A=INT(RND(1)*40)+1
40 B=INT(RND(1)*40)+1
50 C=INT(RND(1)*200)+1
60 FOR X=0 TO 200
70 T=C-A*X
80 IF T<0 THEN 150
90 Y=INT(T/B)
100 IF B*Y<>T THEN 150
110 N=N+1
120 PRINT N;": ";A;"X + ";B;"Y = ";C
130 PRINT "X=";X;" Y=";Y
140 GOTO 30
150 NEXT X
160 GOTO 30
